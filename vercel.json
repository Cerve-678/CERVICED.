{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo INSTALL_PWD=$(pwd); ls -a | head -40; exit 1",
  "buildCommand": "cd .. && node scripts/build-site.mjs waitlist/dist",
  "outputDirectory": "dist",
  "ignoreCommand": "echo IGNORE_PWD=$(pwd); ls -a | head -40; echo PARENT; ls -a .. | head -40; exit 1",
  "rewrites": [
    {
      "source": "/@:handle",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
