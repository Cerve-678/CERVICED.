{
  "name": "myapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:migrations": "node scripts/audit-migration-manifest.mjs",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update",
    "clean": "expo r -c",
    "vault": "node scripts/gen-vault.mjs",
    "vault:watch": "node scripts/gen-vault.mjs --watch",
    "export:remote-migrations": "node scripts/export-remote-migrations.mjs",
    "export:remote-schema": "node scripts/export-remote-schema-inventory.mjs",
    "verify:live-contract": "node scripts/verify-live-critical-contract.mjs",
    "audit:live-rpc-exposure": "node scripts/audit-live-rpc-exposure.mjs",
    "audit:live-profile-privacy": "node scripts/audit-live-profile-privacy.mjs",
    "audit:live-notification-authority": "node scripts/audit-live-notification-authority.mjs",
    "audit:live-waitlist-authority": "node scripts/audit-live-waitlist-authority.mjs",
    "audit:live-authority": "node scripts/audit-live-authority.mjs",
    "audit:live-provider-lifecycle": "node scripts/audit-live-provider-lifecycle.mjs",
    "audit:live-review-authority": "node scripts/audit-live-review-authority.mjs",
    "audit:live-booking-authority": "node scripts/audit-live-booking-authority.mjs",
    "audit:live-intake-form-authority": "node scripts/audit-live-intake-form-authority.mjs",
    "audit:live-account-hats": "node scripts/audit-live-account-hats.mjs",
    "lint:live-db": "supabase db lint --linked",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/bungee": "^0.4.1",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/lobster": "^0.4.1",
    "@expo-google-fonts/righteous": "^0.4.1",
    "@expo-google-fonts/sniglet": "^0.4.1",
    "@expo-google-fonts/varela-round": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@react-navigation/stack": "^7.4.8",
    "@sentry/react-native": "~7.11.0",
    "@stripe/stripe-react-native": "0.63.0",
    "@supabase/supabase-js": "^2.100.0",
    "aes-js": "^3.1.2",
    "eslint-config-expo": "~55.0.1",
    "expo": "^55.0.0",
    "expo-apple-authentication": "~55.0.17",
    "expo-av": "~16.0.8",
    "expo-blur": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
