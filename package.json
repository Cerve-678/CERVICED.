{
  "name": "myapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:stripe": "node --test scripts/tests/stripe-checkout.test.mjs scripts/tests/stripe-refund.test.mjs scripts/tests/stripe-onboarding.test.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "check:worktree": "node scripts/check-worktree-integrity.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:migrations": "node scripts/audit-migration-manifest.mjs",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update",
    "clean": "expo r -c",
    "vault": "node scripts/gen-vault.mjs",
    "vault:watch": "node scripts/gen-vault.mjs --watch",
    "export:remote-migrations": "node scripts/export-remote-migrations.mjs",
    "export:remote-schema": "node scripts/export-remote-schema-inventory.mjs",
    "verify:live-contract": "node scripts/verify-live-critical-contract.mjs",
    "audit:live-rpc-exposure": "node scripts/audit-live-rpc-exposure.mjs",
    "audit:live-profile-privacy": "node scripts/audit-live-profile-privacy.mjs",
    "audit:live-notification-authority": "node scripts/audit-live-notification-authority.mjs",
    "audit:live-waitlist-authority": "node scripts/audit-live-waitlist-authority.mjs",
    "audit:live-authority": "node scripts/audit-live-authority.mjs",
    "audit:live-provider-lifecycle": "node scripts/audit-live-provider-lifecycle.mjs",
    "audit:live-review-authority": "node scripts/audit-live-review-authority.mjs",
    "audit:live-booking-authority": "node scripts/audit-live-booking-authority.mjs",
    "audit:live-intake-form-authority": "node scripts/audit-live-intake-form-authority.mjs",
    "audit:live-account-hats": "node scripts/audit-live-account-hats.mjs",
    "lint:live-db": "supabase db lint --linked",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/bungee": "^0.4.1",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/lobster": "^0.4.1",
    "@expo-google-fonts/righteous": "^0.4.1",
    "@expo-google-fonts/sniglet": "^0.4.1",
    "@expo-google-fonts/varela-round": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@react-navigation/stack": "^7.4.8",
    "@sentry/react-native": "~8.28.0",
    "@stripe/stripe-react-native": "0.81.0",
    "@supabase/supabase-js": "^2.100.0",
    "aes-js": "^3.1.2",
    "eslint-config-expo": "~58.0.4",
    "expo": "^58",
    "expo-apple-authentication": "~58.0.2",
    "expo-blur": "~58.0.5",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-print": "~58.0.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "jest-expo": "~58.0.13",
    "react": "19.3.0",
    "react-error-boundary": "^6.0.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "detox": "^20.42.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.35.0",
    "jest": "~30.5.2",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "^19.3.0",
    "reactotron-react-native": "^5.1.16",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/",
      "<rootDir>/backups/",
      "<rootDir>/scripts/tests/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/"
    ]
  },
  "private": true
}
